{
  "benchmark_id": "juice-shop-safe-v1",
  "description": "Curated OWASP Juice Shop benchmark limited to findings PentestFlow is designed to detect safely without exploitation.",
  "target": "http://127.0.0.1:3000",
  "supported_ground_truth": [
    {
      "id": "GT-001",
      "title": "Missing Content-Security-Policy",
      "category": "security misconfiguration",
      "severity": "medium",
      "endpoint": "/",
      "method": "GET",
      "cwe_id": "CWE-16",
      "expected_status": "present",
      "aliases": ["Missing Security Headers", "Missing CSP"],
      "notes": "Safe deterministic header check."
    },
    {
      "id": "GT-002",
      "title": "Exposed Admin Endpoint",
      "category": "access control",
      "severity": "high",
      "endpoint": "/administration",
      "method": "GET",
      "expected_status": "present",
      "aliases": ["Admin Panel Exposure", "Admin endpoint accessible"],
      "notes": "Only accessibility observation, not bypass."
    }
  ],
  "out_of_scope_ground_truth": [
    {
      "id": "OOS-001",
      "title": "SQL Injection Challenge",
      "category": "injection",
      "severity": "high",
      "endpoint": "/rest/products/search",
      "method": "GET",
      "expected_status": "out_of_scope",
      "aliases": ["Injection challenge"],
      "notes": "Exploit-heavy challenge intentionally excluded from supported benchmark."
    }
  ]
}
