PENTESTFLOW_ENV=development
PENTESTFLOW_LOG_LEVEL=INFO
PENTESTFLOW_ALLOWED_HOSTS=127.0.0.1,localhost
PENTESTFLOW_ALLOWED_NETWORKS=192.168.56.0/24
PENTESTFLOW_WEB_REQUEST_TIMEOUT=5.0
PENTESTFLOW_NETWORK_SCAN_ENABLED=true
PENTESTFLOW_NETWORK_SCAN_TIMEOUT=20.0
PENTESTFLOW_NUCLEI_ENABLED=true
PENTESTFLOW_NUCLEI_TIMEOUT=30.0
PENTESTFLOW_RAG_ENABLED=true
PENTESTFLOW_RAG_TOP_K=3
PENTESTFLOW_RAG_CHUNK_SIZE=800
PENTESTFLOW_RAG_CHUNK_OVERLAP=120
PENTESTFLOW_RAG_EMBEDDING_MODEL=local-hashing-v1
PENTESTFLOW_RAG_COLLECTION_NAME=pentestflow-security
PENTESTFLOW_RAG_CACHE_ENABLED=true
PENTESTFLOW_LLM_ENABLED=true
PENTESTFLOW_LLM_PROVIDER=ollama
PENTESTFLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434
PENTESTFLOW_OLLAMA_SMALL_MODEL=llama3.2:latest
PENTESTFLOW_OLLAMA_LARGE_MODEL=llama3.2:latest
PENTESTFLOW_LLM_TIMEOUT_SECONDS=60.0
PENTESTFLOW_LLM_MAX_INPUT_CHARS=4000
PENTESTFLOW_ANALYSIS_CONFIDENCE_HIGH=0.85
PENTESTFLOW_ANALYSIS_CONFIDENCE_LOW=0.55
PENTESTFLOW_ANALYSIS_WEIGHT_SCANNER=0.35
PENTESTFLOW_ANALYSIS_WEIGHT_MODEL=0.4
PENTESTFLOW_ANALYSIS_WEIGHT_RAG=0.15
PENTESTFLOW_ANALYSIS_WEIGHT_EVIDENCE=0.1
PENTESTFLOW_INJECTION_SCREEN_ENABLED=true
PENTESTFLOW_ANALYSIS_CACHE_ENABLED=true
PENTESTFLOW_ANALYSIS_PROMPT_VERSION=v3
PENTESTFLOW_VALIDATION_ENABLED=true
PENTESTFLOW_MAX_VALIDATION_REQUESTS_PER_FINDING=3
PENTESTFLOW_MAX_VALIDATION_REQUESTS_PER_SCAN=20
PENTESTFLOW_VALIDATION_TIMEOUT_SECONDS=5.0
PENTESTFLOW_MAX_VALIDATION_ATTEMPTS=2
PENTESTFLOW_VALIDATION_CACHE_ENABLED=true
PENTESTFLOW_VALIDATION_CACHE_TTL_SECONDS=3600
PENTESTFLOW_VALIDATION_ENGINE_VERSION=v1
PENTESTFLOW_MAX_ENDPOINT_PROBES=10
PENTESTFLOW_REPORTS_DIR=reports
PENTESTFLOW_SQLITE_PATH=pentestflow.db
